    "check": "bun run test && bun run typecheck && bun run build"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "packageManager": "bun@1.3.14"
}
